        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{job=\"$log_job\", instance=\"$host\"} | json | msg = `pending package update` | snapshot = `$snapshot_pending`",
          "refId": "A",
          "queryType": "range",
          "maxLines": 2000
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
