{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Log datasource receiving the exporter's JSON log entries",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "1.0.0"
    }
  ],
  "title": "Ubuntu Pro Updates Host",
  "uid": "ubuntu-pro-updates-host",
  "description": "Single-host view of package-update and CVE exposure from ubuntu-pro-updates-exporter: metrics plus the full per-item lists from the exporter's JSON logs, anchored to the newest snapshot.",
  "tags": [
    "ubuntu",
    "security",
    "prometheus-exporter",
    "ubuntu-pro"
  ],
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "ubuntu-pro"
      ],
      "targetBlank": false,
      "title": "Ubuntu Pro dashboards",
      "type": "dashboards"
    }
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-2d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(ubuntu_pro_updates_exporter_up, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "",
          "value": ""
        },
        "options": [],
        "sort": 1
      },
      {
        "name": "log_job",
        "label": "Log job",
        "description": "Loki job label carrying the exporter's log entries; depends on how your log pipeline labels the exporter's unit or container.",
        "type": "textbox",
        "query": "ubuntu-pro-updates-exporter",
        "current": {
          "text": "ubuntu-pro-updates-exporter",
          "value": "ubuntu-pro-updates-exporter",
          "selected": false
        },
        "options": [
          {
            "text": "ubuntu-pro-updates-exporter",
            "value": "ubuntu-pro-updates-exporter",
            "selected": false
          }
        ],
        "hide": 0
      },
      {
        "name": "snapshot_pending",
        "label": "pending snapshot",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "qryType": 3,
          "query": "query_result(ubuntu_pro_updates_list_snapshot_timestamp_seconds{list=\"pending\", instance=\"$host\"})",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "regex": "/ (\\d+) \\d+$/",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "hide": 2,
        "current": {
          "text": "",
          "value": ""
        },
        "options": [],
        "sort": 0
      },
      {
        "name": "snapshot_installed",
        "label": "installed snapshot",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "qryType": 3,
          "query": "query_result(ubuntu_pro_updates_list_snapshot_timestamp_seconds{list=\"installed\", instance=\"$host\"})",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "regex": "/ (\\d+) \\d+$/",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "hide": 2,
        "current": {
          "text": "",
          "value": ""
        },
        "options": [],
        "sort": 0
      },
      {
        "name": "snapshot_cves",
        "label": "cves snapshot",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "qryType": 3,
          "query": "query_result(ubuntu_pro_updates_list_snapshot_timestamp_seconds{list=\"cves\", instance=\"$host\"})",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "regex": "/ (\\d+) \\d+$/",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "hide": 2,
        "current": {
          "text": "",
          "value": ""
        },
        "options": [],
        "sort": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Exporter Up",
      "description": "Whether the pro client query succeeds on this host.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "ubuntu_pro_updates_exporter_up{instance=\"$host\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "UP"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Data Age",
      "description": "Time since the exporter last refreshed successfully.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "time() - ubuntu_pro_updates_exporter_last_success_timestamp_seconds{instance=\"$host\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 93600
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pending Updates",
      "description": "Package updates pending on this host, all pockets.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(ubuntu_pro_updates_pending{instance=\"$host\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Security Updates",
      "description": "Pending updates from the standard-security pocket.",
