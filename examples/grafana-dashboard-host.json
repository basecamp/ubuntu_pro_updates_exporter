    {
      "id": 11,
      "type": "table",
      "title": "Pending Updates",
      "description": "The full pending-update list from the package-update log (-log.package-updates). Anchored to the newest snapshot via ubuntu_pro_updates_list_snapshot_timestamp_seconds, so the table shows exactly one version of the list; widen the time range if it comes up empty. Capped at the query line limit, so exceptionally large result sets truncate.",
      "datasource": {
