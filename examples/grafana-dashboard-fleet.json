{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Log datasource receiving the exporter's JSON log entries",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "1.0.0"
    }
  ],
  "title": "Ubuntu Pro Updates Fleet",
  "uid": "ubuntu-pro-updates-fleet",
  "description": "Fleet view of package-update and CVE exposure from ubuntu-pro-updates-exporter. Zoom into one host with the Ubuntu Pro Updates Host dashboard.",
  "tags": [
    "ubuntu",
    "security",
    "prometheus-exporter",
    "ubuntu-pro"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(ubuntu_pro_updates_exporter_up, instance)",
          "refId": "var"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1
      },
      {
        "name": "log_job",
        "label": "Log job",
        "description": "Loki job label carrying the exporter's log entries; depends on how your log pipeline labels the exporter's unit or container.",
        "type": "textbox",
        "query": "ubuntu-pro-updates-exporter",
        "current": {
          "text": "ubuntu-pro-updates-exporter",
          "value": "ubuntu-pro-updates-exporter",
          "selected": false
        },
        "options": [
          {
            "text": "ubuntu-pro-updates-exporter",
            "value": "ubuntu-pro-updates-exporter",
            "selected": false
          }
        ],
        "hide": 0
      },
      {
        "name": "cvss_min",
        "label": "Min CVSS",
        "description": "CVSS score cutoff for the fleet-wide CVE tables.",
        "type": "textbox",
        "query": "7",
        "current": {
          "text": "7",
          "value": "7",
          "selected": false
        },
        "options": [
          {
            "text": "7",
            "value": "7",
            "selected": false
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Hosts Reporting",
      "description": "Hosts where the exporter is scraped and reporting.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(ubuntu_pro_updates_exporter_up{instance=~\"$instance\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pro Client Broken",
      "description": "Hosts where the exporter runs but the pro client query fails.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(ubuntu_pro_updates_exporter_up{instance=~\"$instance\"} == 0) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Reboot Required",
      "description": "Hosts currently requiring a reboot.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(ubuntu_pro_updates_reboot_required{state=~\"yes|yes-kernel-livepatches-applied\",instance=~\"$instance\"} == 1) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "ESM-locked Security Fixes",
      "description": "Pending security fixes that exist in ESM pockets but cannot be installed because hosts are not attached to Ubuntu Pro.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(ubuntu_pro_updates_pending{status=\"pending_attach\",instance=~\"$instance\"}) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Attached to Ubuntu Pro",
      "description": "Hosts attached to an Ubuntu Pro subscription.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(ubuntu_pro_updates_attached{instance=~\"$instance\"} == 1) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Pro Client Versions",
      "description": "Installed pro client versions; CVE data needs client 35 or newer.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count by (version) (ubuntu_pro_updates_client_info{instance=~\"$instance\"})",
          "refId": "A",
          "legendFormat": "{{version}}",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Pending Updates by Pocket",
      "description": "Pending package updates by pocket; the esm pockets carry security fixes only available with Ubuntu Pro.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (pocket) (ubuntu_pro_updates_pending{instance=~\"$instance\"})",
          "refId": "A",
          "legendFormat": "{{pocket}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Pending Updates by Status",
      "description": "pending_attach means a security fix exists in ESM but the host is not attached.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (status) (ubuntu_pro_updates_pending{instance=~\"$instance\"})",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Pending Download Size",
      "description": "Total download size of pending updates.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (pocket) (ubuntu_pro_updates_download_bytes{instance=~\"$instance\"})",
          "refId": "A",
          "legendFormat": "{{pocket}}"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "CVEs In Effect by Priority",
      "description": "Distinct CVEs with no applicable fix: vulnerable (no fix released) and unknown (fix availability undetermined). Needs pro client 35+.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (priority, fix_status) (ubuntu_pro_updates_cves{fix_status=~\"vulnerable|unknown\",instance=~\"$instance\"})",
          "refId": "A",
          "legendFormat": "{{priority}} ({{fix_status}})"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Unapplied CVE Fixes by Pocket",
      "description": "Package-CVE pairs with a released fix not yet applied; esm pockets need an Ubuntu Pro subscription.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (origin) (ubuntu_pro_updates_cve_fixes{instance=~\"$instance\"})",
          "refId": "A",
          "legendFormat": "{{origin}}"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 11,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Installed Packages by Origin",
      "description": "Installed packages by archive origin; third-party and unknown growth are drift signals.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (origin) (ubuntu_pro_updates_installed_packages{instance=~\"$instance\"})",
          "refId": "A",
          "legendFormat": "{{origin}}"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 11,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Top CVEs Across the Fleet (CVSS >= $cvss_min, kernel excluded)",
      "description": "CVEs from the exporter's CVE log top by number of affected hosts, sorted by CVSS score, with the number of hosts each one affects. Counted over the dashboard time range from the JSON log entries; kernel packages have their own table. Capped at the query line limit, so exceptionally large result sets truncate.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "topk(30, count by (cve, cvss_score, cvss_severity, priority, fix_status) (sum by (cve, cvss_score, cvss_severity, priority, fix_status, instance) (count_over_time({job=\"$log_job\", instance=~\"${instance:regex}\"} | json | msg = `cve` | cvss_score >= $cvss_min | __error__ = `` | package !~ `linux-.*` [$__range]))))",
          "refId": "A",
          "queryType": "instant",
          "maxLines": 1000
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cvss_score"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 4
                    },
                    {
                      "color": "orange",
                      "value": 7
                    },
                    {
                      "color": "red",
                      "value": 9
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "cvss_score",
                "cvss_severity",
                "cve",
                "priority",
                "fix_status",
                "Value"
              ]
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "cvss_score",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "cvss_score",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "cvss_score": 0,
              "cvss_severity": 1,
              "cve": 2,
              "priority": 3,
              "fix_status": 4,
              "Value": 5
            },
            "renameByName": {
              "Value": "Hosts affected"
            }
          }
        }
      ]
    },
    {
      "id": 14,
      "type": "table",
      "title": "Top Kernel CVEs Across the Fleet (CVSS >= $cvss_min)",
      "description": "Kernel-package CVEs top by number of affected hosts, sorted by CVSS score with the number of hosts affected. Kept separate because kernel CVEs resolve through kernel upgrades and reboots, not package-by-package patching. Capped at the query line limit, so exceptionally large result sets truncate.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "topk(30, count by (cve, cvss_score, cvss_severity, priority, fix_status) (sum by (cve, cvss_score, cvss_severity, priority, fix_status, instance) (count_over_time({job=\"$log_job\", instance=~\"${instance:regex}\"} | json | msg = `cve` | cvss_score >= $cvss_min | __error__ = `` | package =~ `linux-.*` [$__range]))))",
          "refId": "A",
          "queryType": "instant",
          "maxLines": 1000
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cvss_score"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 4
                    },
                    {
                      "color": "orange",
                      "value": 7
                    },
                    {
                      "color": "red",
                      "value": 9
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "cvss_score",
                "cvss_severity",
                "cve",
                "priority",
                "fix_status",
                "Value"
              ]
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "cvss_score",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "sortBy",
